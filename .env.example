# Copy to .env and fill in. .env is gitignored. Do not commit names, addresses, or keys.

# Where the project lives (output/, state.json, digest-history.json, and bot-updates/ go here).
# Defaults to the directory that contains the scripts.
DIGEST_HOME=
# CUPS queue that accepts raw TSPL2 for the 80 mm receipt printer.
DIGEST_PRINTER_QUEUE=receipt
# Loopback port the Home Assistant trigger listens on.
DIGEST_TRIGGER_PORT=8793

# Location. The default point is the public city center of Bastrop, Texas, not a street address.
DIGEST_TZ=America/Chicago
DIGEST_LOCATION_LABEL=Bastrop, TX
DIGEST_WEATHER_LAT=30.1105
DIGEST_WEATHER_LON=-97.3153
# DIGEST_WEATHER_POINT=

# Local news. Leave the feed variables empty to use the built-in Google News queries
# plus Community Impact and Eater Austin, filtered to Bastrop and nearby towns.
# DIGEST_LOCAL_NEWS_QUERY=
# DIGEST_LOCAL_FEED=
# DIGEST_LOCAL_FEEDS=
# DIGEST_COMMUNITY_IMPACT_FEED=https://communityimpact.com/rss/
# DIGEST_EATER_AUSTIN_FEED=https://austin.eater.com/rss/index.xml

# Company news. Leave these empty to use Google News queries for SpaceX and Earth Funeral.
# DIGEST_SPACEX_QUERY=
# DIGEST_EARTH_FUNERAL_QUERY=
# DIGEST_SPACEX_FEED=
# DIGEST_EARTH_FUNERAL_FEED=
# DIGEST_COMPANIES_FEED=
# DIGEST_COMPANIES_FEEDS=

# Global news.
DIGEST_GLOBAL_FEED=https://feeds.bbci.co.uk/news/world/rss.xml
DIGEST_TASTE=cerebral sci-fi, space, horror, and new local food and drink openings; skip politics, celebrity gossip, and sports.

# Interests profile and artist list. Copy the examples, keep the copies out of git, and point these at them.
# DIGEST_PROFILE_FILE=
# DIGEST_ARTISTS_FILE=
# DIGEST_FRESH_HOURS=36
# DIGEST_COMPANY_STALE_HOURS=336

# Nearby shows. Ticketmaster Discovery API. No key, no file, or no matches: the section is omitted.
# DIGEST_TICKETMASTER_KEY=
# DIGEST_SHOWS_LAT=30.1105
# DIGEST_SHOWS_LON=-97.3153
# DIGEST_SHOWS_RADIUS_MILES=50
# DIGEST_SHOWS_HORIZON_DAYS=90

# Section order and headers. shows and bot_updates are omitted when empty.
# DIGEST_SECTION_ORDER=weather,global,local,companies,shows,bot_updates
# DIGEST_SECTION_TITLES={"local":"BASTROP"}
# Per-section titles override the JSON object. Defaults are the headers below.
# DIGEST_SECTION_TITLE_WEATHER=WEATHER
# DIGEST_SECTION_TITLE_GLOBAL=GLOBAL
# DIGEST_SECTION_TITLE_LOCAL=BASTROP
# DIGEST_SECTION_TITLE_COMPANIES=SPACEX & EARTH FUNERAL
# DIGEST_SECTION_TITLE_SHOWS=NEARBY SHOWS
# DIGEST_SECTION_TITLE_BOT_UPDATES=BOT UPDATES

# OpenAI-compatible chat completions. No key: the deterministic picker runs and the print still happens.
# grok-4.7 is the current default model id. Change DIGEST_LLM_MODEL when that id changes.
DIGEST_LLM_BASE_URL=https://api.x.ai/v1
DIGEST_LLM_API_KEY=
DIGEST_LLM_MODEL=grok-4.7
# Seconds for one chat call. The generator's whole fetch-and-pick budget is 75s,
# and this call is shortened to whatever time is left. A HTTP 400 retry uses the same budget.
DIGEST_LLM_TIMEOUT=45
# low, medium, high, xhigh, or off. Default low so the morning job does not spend the timeout reasoning.
DIGEST_LLM_REASONING_EFFORT=low

# How many feed items to consider, how many to print, and how long a summary may be.
# With a bot section the other sections get fewer, shorter items. Without it they get the space.
# DIGEST_CANDIDATES_PER_SECTION=16
# DIGEST_ITEMS_WITH_BOTS=1
# DIGEST_ITEMS_WITHOUT_BOTS=2
# DIGEST_SUMMARY_CHARS_WITH_BOTS=200
# DIGEST_SUMMARY_CHARS_WITHOUT_BOTS=300

# Cross-day duplicates. URLs and normalized titles from the last N days are skipped.
# The current digest date is not used as a block, so a crashed run can be rebuilt.
# DIGEST_HISTORY_PATH=
# DIGEST_HISTORY_DAYS=7

# Bot updates dropped off by an external process. See docs/bot-updates.md.
# Reader ids are private. Set them here; do not put real names in the repository.
# DIGEST_BOT_UPDATES_DIR=
DIGEST_READER_IDS=reader-a,reader-b
# DIGEST_BOT_UPDATES_MAX_AGE_HOURS=30
# DIGEST_BOT_UPDATES_FUTURE_SKEW_MINUTES=120
# DIGEST_BOT_UPDATES_MAX=4
