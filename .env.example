# Copy to .env and fill in. No API keys are needed today; all sources are public.

# Where the project lives (output/ and state.json are written here). Defaults to the script directory.
DIGEST_HOME=
# CUPS queue that accepts raw TSPL2 for the 80 mm receipt printer.
DIGEST_PRINTER_QUEUE=receipt
# Loopback port the Home Assistant trigger listens on.
DIGEST_TRIGGER_PORT=8793

# Location
DIGEST_TZ=America/Chicago
DIGEST_LOCATION_LABEL=near Springfield
DIGEST_WEATHER_LAT=39.7817
DIGEST_WEATHER_LON=-89.6501
DIGEST_LOCAL_NEWS_QUERY=Springfield
DIGEST_LOCAL_CITY=Springfield

# Local events: a WordPress Modern Events Calendar page, then a GrowthZone chamber calendar as fallback.
DIGEST_NEIGHBORHOOD_EVENTS_URL=https://neighborhood.example.org/events/
DIGEST_NEIGHBORHOOD_NAME=Neighborhood
# Comma-separated words that mark an event as "in the neighborhood" (venue, organizer, address).
DIGEST_NEIGHBORHOOD_MARKERS=neighborhood
DIGEST_CHAMBER_EVENTS_URL=https://business.chamber.example.com/eventcalendar

# Interests
DIGEST_MARKETS_NEWS_QUERY=SpaceX OR Rocket Lab OR ASTS stock
DIGEST_FILM_TERMS=anime,thriller,western,animation
DIGEST_TASTE=mystery-box world-building, character-driven thrillers, action anime, westerns
